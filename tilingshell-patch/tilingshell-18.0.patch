+// Local patch (2026-11-18): pure helpers for the layout editor, no GNOME imports.
+// A "line" is one tile edge shared by tiles on both sides. The tiles' `groups`
+// say which lines move together: tiles sharing a group id belong to one slider.
+// toggleLineLink() lets the user join the pieces of one straight line across
+// columns (one slider moves them all) or split it into separate pieces again.
+
+const EPS = 0.002;
+
+const near = (a, b) => Math.abs(a - b) < EPS;
+
+// Tiles on both sides of the line at coordinate c, pieces = connected parts.
+// vertical=true -> line x=c (tiles left/right of it); else line y=c.
+function _segmentsAt(tiles, vertical, c) {
+  const pos = (t) => (vertical ? t.x : t.y);
+  const len = (t) => (vertical ? t.width : t.height);
+  const apos = (t) => (vertical ? t.y : t.x);
+  const alen = (t) => (vertical ? t.height : t.width);
+  const prev = tiles.filter((t) => near(pos(t) + len(t), c));
+  const next = tiles.filter((t) => near(pos(t), c));
+  const parent = new Map();
+  const find = (t) => {
+    while (parent.get(t) !== t) {
+      parent.set(t, parent.get(parent.get(t)));
+      t = parent.get(t);
+    }
+    return t;
+  };
+  const touched = new Set();
+  for (const p of prev) for (const n of next) {
+    const overlap = Math.min(apos(p) + alen(p), apos(n) + alen(n)) - Math.max(apos(p), apos(n));
+    if (overlap <= EPS) continue;
+    for (const t of [p, n]) if (!parent.has(t)) parent.set(t, t);
+    parent.set(find(p), find(n));
+    touched.add(p);
+    touched.add(n);
+  }
+  const comps = new Map();
+  for (const t of touched) {
+    const r = find(t);
+    if (!comps.has(r)) comps.set(r, []);
+    comps.get(r).push(t);
+  }
+  return [...comps.values()].map((members) => ({
+    prev: members.filter((t) => prev.includes(t)),
+    next: members.filter((t) => next.includes(t)),
+    from: Math.min(...members.map(apos)),
+    to: Math.max(...members.map((t) => apos(t) + alen(t))),
+  }));
+}
+
+// Every internal straight line as chains of touching pieces.
+// Returns [{vertical, c, from, to, segments:[{prev,next,from,to}]}]
+export function findChains(tiles) {
+  const out = [];
+  for (const vertical of [true, false]) {
+    const coords = [];
+    for (const t of tiles) {
+      const c = vertical ? t.x + t.width : t.y + t.height;
+      if (c > EPS && c < 1 - EPS && !coords.some((k) => near(k, c))) coords.push(c);
+    }
+    for (const c of coords) {
+      const segs = _segmentsAt(tiles, vertical, c).sort((a, b) => a.from - b.from);
+      let chain = null;
+      for (const s of segs) {
+        if (chain && s.from <= chain.to + EPS) {
+          chain.segments.push(s);
+          chain.to = Math.max(chain.to, s.to);
+        } else {
+          chain = { vertical, c, from: s.from, to: s.to, segments: [s] };
+          out.push(chain);
+        }
+      }
+    }
+  }
+  return out;
+}
+
+// Chain nearest to a pointer (normalised 0..1 coords) within maxPx pixels.
+export function pickChain(tiles, nx, ny, width, height, maxPx) {
+  let best = null;
+  let bestD = maxPx;
+  for (const ch of findChains(tiles)) {
+    let d;
+    if (ch.vertical) {
+      const dx = Math.abs(nx - ch.c) * width;
+      const dy = (ny < ch.from ? ch.from - ny : ny > ch.to ? ny - ch.to : 0) * height;
+      d = Math.hypot(dx, dy);
+    } else {
+      const dy = Math.abs(ny - ch.c) * height;
+      const dx = (nx < ch.from ? ch.from - nx : nx > ch.to ? nx - ch.to : 0) * width;
+      d = Math.hypot(dx, dy);
+    }
+    if (d <= bestD) {
+      bestD = d;
+      best = ch;
+    }
+  }
+  return best;
+}
+
+// Group ids that run along this segment: shared by a tile on each side.
+function _segmentIds(seg) {
+  const ids = new Set();
+  for (const p of seg.prev) for (const n of seg.next)
+    for (const g of p.groups) if (n.groups.includes(g)) ids.add(g);
+  return ids;
+}
+
+function _chainTiles(chain) {
+  const set = new Set();
+  for (const s of chain.segments) {
+    s.prev.forEach((t) => set.add(t));
+    s.next.forEach((t) => set.add(t));
+  }
+  return [...set];
+}
+
+function _freshId(tiles) {
+  let max = 0;
+  for (const t of tiles) for (const g of t.groups) max = Math.max(max, g);
+  return max + 1;
+}
+
+// "attached" when one group id runs through every piece of a multi-piece chain.
+export function isAttached(chain) {
+  if (chain.segments.length < 2) return false;
+  const all = chain.segments.map(_segmentIds);
+  return [...all[0]].some((g) => all.every((s) => s.has(g)));
+}
+
+// Toggle the chain: attached -> one group per piece; else -> one group for all.
+// Mutates tile.groups. Returns "separated" | "attached" | "single".
+export function toggleChain(tiles, chain) {
+  const members = _chainTiles(chain);
+  const old = new Set();
+  chain.segments.forEach((s) => _segmentIds(s).forEach((g) => old.add(g)));
+  const strip = () => members.forEach((t) => {
+    t.groups = t.groups.filter((g) => !old.has(g));
+  });
+  if (isAttached(chain)) {
+    strip();
+    let id = _freshId(tiles);
+    for (const s of chain.segments) {
+      for (const t of [...s.prev, ...s.next]) t.groups.push(id);
+      id++;
+    }
+    return "separated";
+  }
+  if (chain.segments.length === 1 && old.size === 1) return "single";
+  strip();
+  const id = _freshId(tiles);
+  members.forEach((t) => t.groups.push(id));
+  return "attached";
+}
+
+// For the editor: orientation + coordinate of one group's line when every tile
+// of the group touches the same line (works for chains of several pieces,
+// which the stock detection misreads). null -> use the stock detection.
+// Returns {vertical, c, tile} where tile is a member whose edge lies on it.
+export function groupLine(groupTiles) {
+  for (const vertical of [true, false]) {
+    for (const t of groupTiles) {
+      const c = vertical ? t.x + t.width : t.y + t.height;
+      const prev = groupTiles.filter((u) => near(vertical ? u.x + u.width : u.y + u.height, c));
+      const next = groupTiles.filter((u) => near(vertical ? u.x : u.y, c));
+      if (prev.length && next.length && prev.length + next.length === groupTiles.length)
+        return { vertical, c, tile: prev[0] };
+    }
+  }
+  return null;
+}
