diff -ruN a/components/layout/lineGroups.js b/components/layout/lineGroups.js
--- a/components/layout/lineGroups.js	1970-01-01 01:00:00.000000000 +0100
+++ b/components/layout/lineGroups.js	2026-11-25 19:04:45.511902261 +0100
@@ -0,0 +1,60 @@
+// Local patch (2026-11-18): line groups for the layout editor. A "line" is one
+// tile edge shared by tiles on both sides; tiles sharing a group id belong to
+// one slider. The logic is Rust, in Nero's core/src/line_groups.rs, run as
+// WebAssembly through utils/nero.js. Rust refers to tiles by index; these
+// wrappers hand back the tile objects themselves, as the old JS did.
+import { call } from "../../utils/nero.js";
+
+const plain = (t) => ({ x: t.x, y: t.y, width: t.width, height: t.height, groups: [...t.groups] });
+
+// chain with tile indexes (from Rust) -> chain with tile objects
+const toObjects = (tiles, ch) => ch && {
+  ...ch,
+  segments: ch.segments.map((s) => ({ ...s, prev: s.prev.map((i) => tiles[i]), next: s.next.map((i) => tiles[i]) })),
+};
+// chain with tile objects -> chain with tile indexes
+const toIndexes = (tiles, ch) => {
+  const ix = (t) => {
+    const i = tiles.indexOf(t);
+    if (i < 0) throw new Error("lineGroups: chain tile is not in tiles");
+    return i;
+  };
+  return { ...ch, segments: ch.segments.map((s) => ({ ...s, prev: s.prev.map(ix), next: s.next.map(ix) })) };
+};
+
+// Every internal straight line as chains of touching pieces.
+// Returns [{vertical, c, from, to, segments:[{prev,next,from,to}]}]
+export function findChains(tiles) {
+  return call("findChains", tiles.map(plain)).map((ch) => toObjects(tiles, ch));
+}
+
+// Chain nearest to a pointer (normalised 0..1 coords) within maxPx pixels.
+export function pickChain(tiles, nx, ny, width, height, maxPx) {
+  return toObjects(tiles, call("pickChain", tiles.map(plain), nx, ny, width, height, maxPx));
+}
+
+// "attached" when one group id runs through every piece of a multi-piece chain.
+// The chain's tiles are read as they are now.
+export function isAttached(chain) {
+  const tiles = [...new Set(chain.segments.flatMap((s) => [...s.prev, ...s.next]))];
+  return call("isAttached", tiles.map(plain), toIndexes(tiles, chain));
+}
+
+// Toggle the chain: attached -> one group per piece; else -> one group for all.
+// Mutates tile.groups. Returns "separated" | "attached" | "single".
+export function toggleChain(tiles, chain) {
+  const { result, groups } = call("toggleChain", tiles.map(plain), toIndexes(tiles, chain));
+  tiles.forEach((t, i) => {
+    const g = groups[i];
+    if (g.length !== t.groups.length || g.some((id, k) => id !== t.groups[k])) t.groups = g;
+  });
+  return result;
+}
+
+// For the editor: orientation + coordinate of one group's line when every tile
+// of the group touches the same line. null -> use the stock detection.
+// Returns {vertical, c, tile} where tile is a member whose edge lies on it.
+export function groupLine(groupTiles) {
+  const found = call("groupLine", groupTiles.map(plain));
+  return found && { ...found, tile: groupTiles[found.tile] };
+}
